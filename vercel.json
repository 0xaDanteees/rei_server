{
    "builds": [
        {
            "src": "api/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "services/auth/app/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "services/partners/app/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "services/inventory/app/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "services/rag/app/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        { "src": "/auth", "dest": "/services/auth/app/main.py" },
        { "src": "/auth/(.*)", "dest": "/services/auth/app/main.py" },
        { "src": "/partners", "dest": "/services/partners/app/main.py" },
        { "src": "/partners/(.*)", "dest": "/services/partners/app/main.py" },
        { "src": "/inventory", "dest": "/services/inventory/app/main.py" },
        { "src": "/inventory/(.*)", "dest": "/services/inventory/app/main.py" },
        { "src": "/rag", "dest": "/services/rag/app/main.py" },
        { "src": "/rag/(.*)", "dest": "/services/rag/app/main.py" },
        { "src": "/(.*)", "dest": "/api/main.py" }
    ] 
}