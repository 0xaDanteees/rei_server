# Ops Makefile: stop Docker Compose stack and kill running microservices
# Usage examples:
#   make -f Makefile.ops all-down      # stop docker compose and kill all uvicorn services
#   make -f Makefile.ops docker-down   # only docker compose down
#   make -f Makefile.ops kill-svcs     # only kill uvicorn services (api, auth, partners)
#   make -f Makefile.ops ps            # show relevant processes/ports

SHELL := /bin/bash

# -------- Docker --------
docker-down:
	@echo "[ops] docker compose down --remove-orphans"
	@docker compose down --remove-orphans || true

# -------- Services (uvicorn) --------
# Try graceful kill by name, then by port as fallback
kill-api:
	@echo "[ops] killing API gateway (by name + port 8000)"
	@pkill -f "uvicorn .*api\.main:app" || true
	@lsof -ti:8000 | xargs -I{} kill {} 2>/dev/null || true
	@sleep 0.3
	@lsof -ti:8000 | xargs -I{} kill -9 {} 2>/dev/null || true

kill-auth:
	@echo "[ops] killing Auth service (by name + port 8200)"
	@pkill -f "uvicorn .*services\.auth\.app\.main:app" || true
	@lsof -ti:8200 | xargs -I{} kill {} 2>/dev/null || true
	@sleep 0.3
	@lsof -ti:8200 | xargs -I{} kill -9 {} 2>/dev/null || true

kill-partners:
	@echo "[ops] killing Partners service (by name + port 8300)"
	@pkill -f "uvicorn .*services\.partners\.app\.main:app" || true
	@lsof -ti:8300 | xargs -I{} kill {} 2>/dev/null || true
	@sleep 0.3
	@lsof -ti:8300 | xargs -I{} kill -9 {} 2>/dev/null || true

kill-inventory:
	@echo "[ops] killing Inventory service (by name + port 8400)"
	@pkill -f "uvicorn .*services\.inventory\.app\.main:app" || true
	@lsof -ti:8400 | xargs -I{} kill {} 2>/dev/null || true
	@sleep 0.3
	@lsof -ti:8400 | xargs -I{} kill -9 {} 2>/dev/null || true

kill-svcs: kill-api kill-auth kill-partners kill-inventory
	@echo "[ops] services killed"

# -------- All-in-one --------
all-down: kill-svcs docker-down
	@echo "[ops] everything stopped"

# -------- Diagnostics --------
ps:
	@echo "[ops] Listening on 8000/8200/8300/8400 (if any):" \
	  && (lsof -iTCP:8000 -sTCP:LISTEN || true) \
	  && (lsof -iTCP:8200 -sTCP:LISTEN || true) \
	  && (lsof -iTCP:8300 -sTCP:LISTEN || true) \
	  && (lsof -iTCP:8400 -sTCP:LISTEN || true)
	@echo "[ops] uvicorn processes:" && (ps aux | grep -E "uvicorn .*main:app" | grep -v grep || true)

# -------- Testing --------
# Run all tests across the monorepo (verbose)
test-all:
	@echo "[ops] running all tests (pytest -v)"
	@python -m pytest -v

# Run tests for a specific service (verbose)
test-auth:
	@echo "[ops] running Auth tests"
	@python -m pytest services/auth/app/test_main.py -v

test-partners:
	@echo "[ops] running Partners tests"
	@python -m pytest services/partners/app/test_main.py -v

test-inventory:
	@echo "[ops] running Inventory tests"
	@python -m pytest services/inventory/app/test_main.py -v

# Generic target: pass path with t=...
# Example: make -f Makefile.ops test t=services/inventory/app/main_test.py::test_bundle_management_flow
test:
	@echo "[ops] running tests for $(t)"
	@python -m pytest $(t) -v
